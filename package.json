{
  "name": "uabc",
  "private": true,
  "version": "0.2.0",
  "description": "Universal AI Browser Controller: Chrome extension + native host + MCP server",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:host",
    "build:ext": "node extension/build.mjs",
    "build:ext:store": "node extension/build.mjs --store",
    "build:host": "cargo build --release",
    "watch": "node extension/build.mjs --watch",
    "typecheck": "tsc -p extension --noEmit && tsc -p extension/test --noEmit",
    "test": "npm run test:unit && cargo test",
    "test:unit": "vitest run --root extension",
    "test:e2e": "node --test --test-reporter=spec \"e2e/*.test.mjs\"",
    "icons": "node scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/chrome": "0.3.6",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
